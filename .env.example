# Database — use postgresql+psycopg2:// driver prefix
# Local:
DATABASE_URL=postgresql+psycopg2://finresearch:finresearch@localhost:5432/finresearch
# Neon (production example):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.us-east-2.aws.neon.tech/finresearch?sslmode=require

# LLM providers — set at least one to enable answer generation
# Priority: Anthropic → Google → OpenAI → stub
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
VECTOR_SEARCH_LIMIT=20
HYBRID_ALPHA=0.5
RERANK_ENABLED=false

# Logging
LOG_LEVEL=INFO

# SEC EDGAR — replace with your email
SEC_USER_AGENT=FinResearch your-email@example.com

# App
APP_ENV=development
# Production: set to your deployed frontend URL(s), comma-separated
ALLOWED_ORIGINS=*
PORT=8000
